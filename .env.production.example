# Copy this to `.env` in the SAME directory as docker-compose.yml on the
# deploy server (e.g. /opt/ai-ready/.env). Never commit the real .env --
# it's already covered by the root .gitignore.
#
# Note: `env_file:` in docker-compose does NOT expand ${VAR} references
# across lines -- DATABASE_URL's password must be typed out literally and
# kept in sync with POSTGRES_PASSWORD below, they can't reference each other.

# --- Django ---
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
DEBUG=False
# Public site: http://ai.ingageedutech.com (DNS A record -> the VM's IP).
# The deploy workflow also adds APP_DOMAIN to these two lines automatically.
ALLOWED_HOSTS=ai.ingageedutech.com,your-vm-ip
CORS_ALLOWED_ORIGINS=http://ai.ingageedutech.com,http://your-vm-ip
# Plain HTTP for now (no TLS certificate yet) -- keep this False until HTTPS is set up.
SECURE_SSL_REDIRECT=False

# --- Database (postgres container, service name "db") ---
POSTGRES_DB=aiready
POSTGRES_USER=aiready
POSTGRES_PASSWORD=replace-with-a-strong-password
# Must use the exact same password as POSTGRES_PASSWORD above.
DATABASE_URL=postgres://aiready:replace-with-a-strong-password@db:5432/aiready

# --- Redis / Celery (redis container, service name "redis") ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- AI provider (see backend/.env.example for details) ---
AI_API_KEY=
AI_MODEL=

# --- Email (forgot password + error alerts to admins) ---
# Gmail: use an App Password (Google account > Security > App passwords), not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Comma-separated; they get an email when the server hits an error (production only)
ADMIN_EMAILS=
# Where the reset link in the email points
FRONTEND_BASE_URL=https://ai.ingageedutech.com
PASSWORD_RESET_TIMEOUT=3600

# --- Document processing reliability (backend/config/settings.py has the details) ---
# Shared AI limits per provider + model + API key, across every worker (0 = none). Set a little under the
# account's real limits, e.g. AI_RATE_LIMIT_RPM=50 AI_RATE_LIMIT_TPM=180000.
AI_RATE_LIMIT_RPM=0
AI_RATE_LIMIT_TPM=0
# After "out of quota / credit", other requests with that key stop at once for this long (no retry loop).
AI_QUOTA_EXHAUSTED_HOLD_SECONDS=1800
# Large documents: new AI chunk calls per attempt; the job continues automatically with the rest.
OPENAI_FACT_EXTRACTION_MAX_CHUNKS=20
# Recovery of jobs whose queue message or worker was lost (runs in celery-beat every 5 minutes).
EXTRACTION_RECOVERY_ENABLED=true
EXTRACTION_STALE_SECONDS=1800
# Optional separate OCR queue + worker (docker compose --profile ocr-queue up -d). Leave empty for one queue.
OCR_QUEUE=
EXTRACTION_QUEUE=
# Queue(s) the main celery worker listens on: "celery" (default), or "extraction" with the OCR queue above.
CELERY_WORKER_QUEUES=celery
CELERY_OCR_CONCURRENCY=1
