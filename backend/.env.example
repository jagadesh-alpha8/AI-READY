# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave DATABASE_URL unset to fall back to a local SQLite database (db.sqlite3).
# For PostgreSQL, uncomment and point it at your database:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider (apps.extraction's real AI backend -- required for document
# classification, fact extraction, and conflict detection). Paste an OpenAI
# key ("sk-...") or an Anthropic key ("sk-ant-...") into AI_API_KEY -- the
# provider is auto-detected from the key's own format, so switching
# providers later is just pasting a different key here. AI_MODEL is
# optional; each provider gets a sensible default (gpt-4o-mini / claude-
# haiku-4-5) if left blank. OPENAI_API_KEY/OPENAI_EXTRACTION_MODEL below
# still work unchanged for anyone already using them.
AI_API_KEY=
AI_MODEL=
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=

# Only set this if you're using a local model router, self-hosted gateway,
# or any other OpenAI-*compatible* endpoint instead of OpenAI/Anthropic
# directly (e.g. http://localhost:20128/v1) -- when set, it overrides
# provider auto-detection entirely, and AI_MODEL must be set too (to
# whatever model ID that endpoint expects).
AI_BASE_URL=

# Google Drive Link data source (Screen 2 "Upload Data Pack" -- Google Drive
# option): a plain Drive REST v3 API key, NOT an OAuth client. Create one in
# Google Cloud Console with the "Google Drive API" enabled, no scopes needed.
# Institutions must share their Drive folder as "Anyone with the link --
# Viewer" for this key to be able to list/download its contents.
GOOGLE_DRIVE_API_KEY=

# ---------------------------------------------------------------------------
# Vector store -- semantic retrieval over college document content
# (apps.vector_store). See backend/docs/VECTOR_STORE.md.
#
# ENTIRELY OPTIONAL. Leave these unset and the application behaves exactly as
# it did before this app existed: no Celery task is queued, no row is written,
# and the three vector endpoints answer 503 with a clear reason. Document
# upload, Drive import, AI extraction, fact review, gap detection, CRI scoring,
# baseline approval, recommendations and reports are unaffected either way.
# ---------------------------------------------------------------------------

# --- Pinecone ---
# Create the index yourself first (this app reads it, it does not create it):
# dimension must match EMBEDDING_MODEL (text-embedding-3-small = 1536),
# metric = cosine.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Used only when YOU create the index; recorded here so the setup is documented.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional. Institution isolation is enforced by metadata filtering, so a
# namespace is not required -- it is here for sharing one index across envs.
PINECONE_NAMESPACE=
# integrated = the index embeds server-side (created with an `embed` config,
#              e.g. llama-text-embed-v2) -- no embedding key needed below.
# manual     = this app embeds and upserts raw vectors (needs EMBEDDING_API_KEY).
# auto       = (default) ask the index once per process.
PINECONE_EMBEDDING_MODE=auto

# --- Embeddings ---
# Separate from AI_API_KEY on purpose: Anthropic has no embedding endpoint, so
# a deployment running Claude for extraction still needs an OpenAI-compatible
# key here. Falls back to OPENAI_API_KEY / AI_API_KEY when those are usable.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Only for a model this app does not know the width of; blank = derive it.
EMBEDDING_DIMENSIONS=
# Point at an OpenAI-compatible embedding endpoint instead of OpenAI itself.
EMBEDDING_BASE_URL=

# --- Chunking (a chunk never spans a page and never splits a sentence) ---
VECTOR_CHUNK_MAX_CHARS=1200
# Must be smaller than VECTOR_CHUNK_MAX_CHARS or chunking cannot terminate.
VECTOR_CHUNK_OVERLAP_CHARS=150
# Below this a chunk is page furniture (a header, a page number).
VECTOR_CHUNK_MIN_CHARS=40

# --- Indexing retries (recoverable failures only; permanent ones fail fast) ---
VECTOR_INDEX_MAX_RETRIES=3
VECTOR_INDEX_RETRY_BACKOFF_SECONDS=20

# --- Search ---
VECTOR_SEARCH_DEFAULT_TOP_K=5
VECTOR_SEARCH_MAX_TOP_K=50
