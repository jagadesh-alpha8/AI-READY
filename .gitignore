# Redis dump (regenerated locally, never part of the app)
dump.rdb
*.rdb

# Root-level env file for docker-compose on the deploy server
.env
.env.production

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local DB/media exports for moving data to the server -- contain user data, never commit
transfer/

# Server-only files on the VM (/opt/ai-ready) -- never committed
backups/
docker-compose.override.yml
nginx-routers.conf
.env.before-*
