# Copy to .env (or .env.local) and adjust. No secrets belong here: every VITE_* value is
# compiled into the browser bundle and is public.

# Base URL of the backend API as the browser calls it.
# Default "/api/v1" goes through the Vite dev proxy below (no CORS needed).
# For a backend on another origin use e.g. https://api.example.com/api/v1 and add this
# frontend's origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Dev server only: where the Vite proxy forwards /api requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Dev server port (the backend's default CORS list already allows 5173).
VITE_DEV_PORT=5173
